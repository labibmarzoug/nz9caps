<section class="wrap collections-intro">
  {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
    <div class="section-head">
      <div>
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
  <nav class="cat-circles" aria-label="Collections">
    {%- for block in section.blocks -%}
      <a class="cat-orb{% if request.path == block.settings.link %} is-on{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="">
        {%- else -%}
          <span class="cat-orb-mark">✦</span>
        {%- endif -%}
        <span class="cat-orb-copy">
          {{ block.settings.title }}
          <i aria-hidden="true">→</i>
        </span>
      </a>
    {%- endfor -%}
  </nav>
</section>

{% schema %}
{
  "name": "Cercles collections",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit titre", "default": "Collections" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Shop the drop." }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "circle",
      "name": "Collection",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Hoodies" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cercles collections",
      "blocks": [
        { "type": "circle", "settings": { "title": "Hoodies" } },
        { "type": "circle", "settings": { "title": "Caps" } },
        { "type": "circle", "settings": { "title": "Long Sleeves" } },
        { "type": "circle", "settings": { "title": "All Products" } }
      ]
    }
  ]
}
{% endschema %}
