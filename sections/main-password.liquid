<section class="wrap coming-soon glass">
  <div>
    <b>{{ shop.name }}</b>
    <p>{{ section.settings.text }}</p>
    {% form 'storefront_password' %}
      <div class="newsletter-row">
        <input type="password" name="password" placeholder="Mot de passe">
        <button class="btn" type="submit">Entrer</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Mot de passe",
  "settings": [
    { "type": "text", "id": "text", "label": "Texte", "default": "La boutique ouvre bientôt." }
  ]
}
{% endschema %}
