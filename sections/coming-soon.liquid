<section class="wrap collection-block">
  <div class="section-head">
    <div>
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="collection-title">{{ section.settings.title }}</h2>
    </div>
  </div>
  <div class="coming-soon glass">
    <div>
      <b>{{ section.settings.heading }}</b>
      <p>{{ section.settings.text }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coming soon",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit titre", "default": "Next drop" },
    { "type": "text", "id": "title", "label": "Titre section", "default": "Long Sleeves" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Coming soon." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Le drop Long Sleeves arrive. Reste dans le shop pour le drop." }
  ],
  "presets": [{ "name": "Coming soon" }]
}
{% endschema %}
