<section class="wrap collection-block">
  <div class="section-head">
    <div>
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="collection-title">{{ section.settings.title }}</h2>
    </div>
    {%- if section.settings.button_label != blank -%}
      <a class="btn ghost" href="{{ section.settings.button_link | default: section.settings.collection.url | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.coming_soon -%}
    <div class="coming-soon glass">
      <div>
        <b>{{ section.settings.coming_title }}</b>
        <p>{{ section.settings.coming_text }}</p>
      </div>
    </div>
  {%- elsif section.settings.collection != blank -%}
    <div class="product-grid">
      {%- for product in section.settings.collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>Aucun produit dans cette collection.</p>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="coming-soon glass">
      <div>
        <b>Choisis une collection</b>
        <p>Dans l’éditeur Shopify, sélectionne une collection pour afficher les produits.</p>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collection vedette",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit titre", "default": "Drop" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Hoodies" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Nombre de produits", "default": 4 },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "View All" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "checkbox", "id": "coming_soon", "label": "Afficher Coming soon", "default": false },
    { "type": "text", "id": "coming_title", "label": "Titre coming soon", "default": "Coming soon." },
    { "type": "textarea", "id": "coming_text", "label": "Texte coming soon", "default": "Le drop Long Sleeves arrive. Reste dans le shop pour le drop." }
  ],
  "presets": [{ "name": "Collection vedette" }]
}
{% endschema %}
