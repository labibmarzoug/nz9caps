<section class="wrap page-content">
  <div class="section-head">
    <div>
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
  </div>
  {% form 'contact' %}
    {%- if form.posted_successfully? -%}
      <p>Message envoyé.</p>
    {%- endif -%}
    {{ form.errors | default_errors }}
    <div class="field-row">
      <input type="text" name="contact[name]" placeholder="Nom" required>
      <input type="email" name="contact[email]" placeholder="Email" required>
    </div>
    <textarea name="contact[body]" placeholder="Message" required></textarea>
    <button class="btn" type="submit">{{ section.settings.button_label }}</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "Formulaire contact",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit titre", "default": "Studio" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Contact" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Envoyer" }
  ],
  "presets": [{ "name": "Formulaire contact" }]
}
{% endschema %}
