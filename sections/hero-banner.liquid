<section class="home-hero" aria-label="Hero">
  <div class="hero-banner">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.heading | escape }}">
    {%- else -%}
      <img src="{{ 'hero.png' | asset_url }}" alt="{{ section.settings.heading | escape }}">
    {%- endif -%}
    <div class="slide-shade"></div>
    <div class="slide-copy">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image hero" },
    { "type": "text", "id": "kicker", "label": "Petit titre", "default": "Streetwear × haute couture" },
    { "type": "text", "id": "heading", "label": "Grand titre", "default": "More than just clothes." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Hoodies en solde. Livraison gratuite 24h–48h." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
