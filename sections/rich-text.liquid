<section class="wrap page-content">
  <div class="section-head">
    <div>
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
  </div>
  {%- if section.settings.text != blank -%}
    <div class="rte">{{ section.settings.text }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Texte",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Petit titre" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "richtext", "id": "text", "label": "Texte" }
  ],
  "presets": [{ "name": "Texte" }]
}
{% endschema %}
